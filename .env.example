# Public production origin used by canonical, Open Graph, sitemap, and robots metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Required for Google sign-in and read-only YouTube library sync.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Optional but recommended for production search and YouTube result pagination.
YOUTUBE_API_KEY=replace-with-youtube-data-api-key

